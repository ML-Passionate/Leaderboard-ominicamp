# Copy to .streamlit/secrets.toml (local) or paste into
# Streamlit Cloud > App > Settings > Secrets. NEVER commit the real file.

# Option A (recommended): full Cookie header of a logged-in session.
# Must contain appSession=... (may be split into appSession.0, appSession.1).
OMNI_COOKIE = "appSession=PASTE_HERE; other_cookies=..."

# Option B: just the JWT token (expires in ~24 h).
# OMNI_ACCESS_TOKEN = "eyJhbGciOi..."

# Optional
OMNI_COURSE_ID = "170"
OMNI_ASSIGNMENT_ID = "1038"
TOP_FRACTION = "0.20"
SHOW_NAMES = "true"          # "false" hides participant names
CACHE_TTL_SECONDS = "300"
